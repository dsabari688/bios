{
  "name": "bios-frontend",
  "private": true,
  "version": "0.0.0",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite --port=9000 --host=0.0.0.0",
    "build": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run build:electron && cross-env NODE_ENV=development electron .",
    "electron:build": "npm run build && npm run build:electron && electron-builder",
    "electron:package": "npm run build && npm run build:electron && npx electron-packager . BIOS --platform=win32 --arch=x64 --out=release-win --overwrite --prune=false",
    "electron:build:portable": "npm run build && npm run build:electron && electron-builder --win portable",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:build:release": "npm run android:sync && cd android && ./gradlew assembleRelease bundleRelease",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js dist-electron dist-electron-build",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.2",
    "vite": "^6.2.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "electron": "34.0.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "esbuild": "^0.25.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.bios.app",
    "productName": "BIOS",
    "electronVersion": "34.0.0",
    "directories": {
      "output": "release-electron"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/favicon.svg"
    }
  }
}
